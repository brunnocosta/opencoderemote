{
  "name": "@opencode-ai/mobile",
  "version": "1.15.10",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build:web-assets": "bun run script/build-web-assets.ts",
    "clean:android": "bun run script/clean-android.ts",
    "dev": "expo start",
    "android": "bun run clean:android && expo prebuild --platform android && bun run build:web-assets && CMAKE_BUILD_PARALLEL_LEVEL=1 bunx expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsgo --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "expo": "~54.0.34",
    "expo-dev-client": "~6.0.21",
    "expo-navigation-bar": "~5.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "19.1.10",
    "eslint": "^9.0.0",
    "@typescript/native-preview": "catalog:",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.3"
  }
}
