{
  "expo": {
    "name": "opencode",
    "slug": "opencode-mobile",
    "scheme": "opencode-mobile",
    "version": "1.15.10",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "opencodeapp.web.app"
    },
    "android": {
      "package": "opencodeapp.web.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0b0f14"
      }
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
